# Google Service Account JSON 金鑰（整個 JSON 內容貼入，不換行）
# 格式：{"type":"service_account","project_id":"...","private_key":"..."}
GOOGLE_SERVICE_ACCOUNT_JSON=

# Google Doc 範本 ID（URL 中 /d/ 後的那串）
TEMPLATE_DOC_ID=1DNW4JDp5oDw1tPwAr1Z9oMHWrKNyL3p66fxWyWWtSmk

# PDF 存放的 Google Drive 資料夾 ID（留空則存在 Service Account 的 My Drive）
OUTPUT_FOLDER_ID=

# Vercel API Key（Glide 呼叫時帶入 x-api-key header）
API_KEY=your-vercel-api-key

# Glide 設定
GLIDE_API_TOKEN=e99c6e4d-81ed-4c44-addc-447b4112ed4d
GLIDE_APP_ID=uXuTVTxPL0xZD1HyVaCV
GLIDE_TABLE_NAME=開壇賜名申請表
